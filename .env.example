# Authenticate the Codex CLI with `codex login`. No OpenAI API key is used.
CODEX_BIN=codex
SURGEON_REASONING_EFFORT=medium
SURGEON_TIMEOUT_SECONDS=240
TABLE_PORT=3000
TABLE_DATA_DIR=./data
# auto selects Metal when compiled with --features metal; otherwise CPU.
PATIENT_DEVICE=auto
RAYON_NUM_THREADS=8
